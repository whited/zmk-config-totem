 bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷

                &kp CARET         &kp AMPERSAND          &kp ASTERISK     &kp PIPE           &kp PLUS     &trans  &kp PLUS   &trans  &trans  &trans
                &kp LESS_THAN     &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET   &kp EQUAL    &trans  &kp EQUAL  &trans  &trans  &trans
    &trans      &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp MINUS    &trans  &kp MINUS  &trans  &trans  &trans  &trans
                                                         &trans           &mo 1              &trans       &trans  &trans     &trans
                        >;
                };

